{
  "inputs": [
    {
      "type": "promptString",
      "id": "clawsMailToken",
      "description": "Claws Mail MCP bearer token (see mcp_pluginrc)",
      "password": true
    }
  ],
  "servers": {
    "claws-mail": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "Authorization": "Bearer ${input:clawsMailToken}"
      }
    }
  }
}
